# Copy this file to .env (gitignored) and fill in your own values.

# Flask backend base URL (defaults to http://localhost:5000 if unset).
VITE_API_BASE_URL=http://localhost:5000

# CARTO Basemaps API key (free: https://carto.com/basemaps/apikey).
# Required to avoid the 'API KEY REQUIRED' watermark on dark-theme tiles.
VITE_CARTO_KEY=